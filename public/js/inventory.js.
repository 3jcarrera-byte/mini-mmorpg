// Módulo Independiente de Inventario y Bolso (InventoryModule)
const InventoryModule = (() => {
    let inventoryData = {
        wood: 100,
        stone: 0,
        maxSlots: 20
    };

    function init() {
        createUI();
    }

    function createUI() {
        if (document.getElementById('inventory-modal')) return;

        const container = document.querySelector('.game-container') || document.body;

        // Botón flotante del bolso
        const btnToggle = document.createElement('button');
        btnToggle.id = 'btn-inventory-toggle';
        btnToggle.innerHTML = '🎒 Bolso [B]';
        btnToggle.style.cssText = 'position: absolute; bottom: 20px; right: 20px; z-index: 50; padding: 10px 15px; background: rgba(15, 15, 25, 0.9); color: #00ffcc; border: 2px solid #00ffcc; cursor: pointer; border-radius: 5px; font-family: monospace; font-weight: bold; box-shadow: 0 0 10px rgba(0,255,204,0.3);';
        btnToggle.onclick = toggle;
        container.appendChild(btnToggle);

        // Ventana Modal del Bolso
        const modal = document.createElement('div');
        modal.id = 'inventory-modal';
        modal.style.cssText = 'display: none; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 320px; background: rgba(15, 15, 25, 0.95); border: 2px solid #00ffcc; padding: 20px; color: #fff; z-index: 200; border-radius: 8px; font-family: monospace; box-shadow: 0 0 20px rgba(0,0,0,0.8);';
        modal.innerHTML = `
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #333; padding-bottom: 10px; margin-bottom: 15px;">
                <h3 style="margin: 0; color: #00ffcc; font-size: 18px;">🎒 Inventario del Héroe</h3>
                <button id="close-inv-btn" style="background: none; border: none; color: #ff5555; font-size: 18px; font-weight: bold; cursor: pointer;">✕</button>
            </div>
            <div style="display: flex; flex-direction: column; gap: 10px;">
                <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.05); padding: 10px; border-radius: 4px; border: 1px solid #333;">
                    <span>🪵 Madera</span>
                    <span id="inv-wood-count" style="font-weight: bold; color: #f39c12;">100</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.05); padding: 10px; border-radius: 4px; border: 1px solid #333;">
                    <span>🪨 Piedra</span>
                    <span id="inv-stone-count" style="font-weight: bold; color: #bdc3c7;">0</span>
                </div>
            </div>
        `;
        container.appendChild(modal);

        modal.querySelector('#close-inv-btn').onclick = toggle;

        // Escuchar la tecla B de forma autónoma
        window.addEventListener('keydown', (e) => {
            if (e.code === 'KeyB') {
                toggle();
            }
        });
    }

    function toggle() {
        const modal = document.getElementById('inventory-modal');
        if (!modal) return;
        const isOpen = modal.style.display === 'block';
        if (isOpen) {
            modal.style.display = 'none';
        } else {
            updateDisplay();
            modal.style.display = 'block';
        }
    }

    function updateDisplay() {
        const woodEl = document.getElementById('inv-wood-count');
        const stoneEl = document.getElementById('inv-stone-count');
        if (woodEl) woodEl.innerText = inventoryData.wood;
        if (stoneEl) stoneEl.innerText = inventoryData.stone;
    }

    function addItem(type, amount) {
        if (inventoryData[type] !== undefined) {
            inventoryData[type] += amount;
            updateDisplay();
            
            // Sincronizar también con el HUD principal si existe
            if (type === 'wood') {
                const woodHud = document.getElementById('ui-wood');
                if (woodHud) woodHud.innerText = inventoryData.wood;
            }
        }
    }

    return {
        init,
        toggle,
        addItem,
        getData: () => inventoryData
    };
})();

window.InventoryModule = InventoryModule;
