// Módulo de Inventario Basado en Slots Visuales (inventory.js)
const InventoryModule = (() => {
    // Configuración del inventario: 20 slots totales
    const maxSlots = 20;
    let items = [
        { id: 1, type: 'wood', name: 'Madera', count: 100, icon: '🪵' },
        { id: 2, type: 'stone', name: 'Piedra', count: 0, icon: '🪨' }
    ];

    function init() {
        createUI();
    }

    function createUI() {
        if (document.getElementById('inventory-modal')) return;

        const container = document.querySelector('.game-container') || document.body;

        // 1. Botón flotante para abrir/cerrar el bolso
        const btnToggle = document.createElement('button');
        btnToggle.id = 'btn-inventory-toggle';
        btnToggle.innerHTML = '🎒 Bolso [B]';
        btnToggle.style.cssText = 'position: absolute; bottom: 20px; right: 20px; z-index: 50; padding: 10px 15px; background: rgba(15, 15, 25, 0.9); color: #00ffcc; border: 2px solid #00ffcc; cursor: pointer; border-radius: 5px; font-family: monospace; font-weight: bold; box-shadow: 0 0 10px rgba(0,255,204,0.3);';
        btnToggle.onclick = toggle;
        container.appendChild(btnToggle);

        // 2. Ventana Modal del Inventario con Cuadrícula (Grid)
        const modal = document.createElement('div');
        modal.id = 'inventory-modal';
        modal.style.cssText = 'display: none; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 380px; background: rgba(15, 15, 25, 0.95); border: 2px solid #00ffcc; padding: 20px; color: #fff; z-index: 200; border-radius: 8px; font-family: monospace; box-shadow: 0 0 25px rgba(0,0,0,0.8);';
        
        modal.innerHTML = `
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #333; padding-bottom: 10px; margin-bottom: 15px;">
                <h3 style="margin: 0; color: #00ffcc; font-size: 16px;">🎒 Bolso del Héroe (Slots)</h3>
                <button id="close-inv-btn" style="background: none; border: none; color: #ff5555; font-size: 18px; font-weight: bold; cursor: pointer;">✕</button>
            </div>
            <div id="inventory-grid" style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; max-height: 260px; overflow-y: auto; padding: 4px;">
                <!-- Los slots se inyectarán dinámicamente aquí -->
            </div>
        `;
        container.appendChild(modal);

        modal.querySelector('#close-inv-btn').onclick = toggle;

        // Escuchar la tecla B para abrir/cerrar
        window.addEventListener('keydown', (e) => {
            if (e.code === 'KeyB') {
                toggle();
            }
        });

        renderGrid();
    }

    function renderGrid() {
        const gridContainer = document.getElementById('inventory-grid');
        if (!gridContainer) return;

        gridContainer.innerHTML = '';

        // Generar los 20 slots de la cuadrícula
        for (let i = 0; i < maxSlots; i++) {
            const slotItem = items[i];
            const slot = document.createElement('div');
            
            slot.style.cssText = 'width: 55px; height: 55px; background: rgba(255, 255, 255, 0.05); border: 1px solid #333; border-radius: 6px; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; font-size: 20px; transition: border-color 0.2s;';

            if (slotItem && slotItem.count > 0) {
                slot.title = `${slotItem.name}: ${slotItem.count}`;
                slot.innerHTML = `
                    <span>${slotItem.icon}</span>
                    <span style="position: absolute; bottom: 2px; right: 4px; font-size: 10px; color: #00ffcc; font-weight: bold; background: rgba(0,0,0,0.7); padding: 1px 3px; border-radius: 3px;">${slotItem.count}</span>
                `;
                slot.style.borderColor = '#00ffcc55';
            } else {
                slot.style.opacity = '0.4';
            }

            gridContainer.appendChild(slot);
        }
    }

    function toggle() {
        const modal = document.getElementById('inventory-modal');
        if (!modal) return;
        const isOpen = modal.style.display === 'block';
        if (isOpen) {
            modal.style.display = 'none';
        } else {
            renderGrid();
            modal.style.display = 'block';
        }
    }

    function addItem(type, amount) {
        let existingItem = items.find(i => i.type === type);
        if (existingItem) {
            existingItem.count += amount;
        } else if (items.length < maxSlots) {
            // Si es un ítem nuevo y hay espacio en los slots
            const icons = { wood: '🪵', stone: '🪨' };
            items.push({
                id: items.length + 1,
                type: type,
                name: type.charAt(0).toUpperCase() + type.slice(1),
                count: amount,
                icon: icons[type] || '📦'
            });
        }

        renderGrid();

        // Sincronizar el contador rápido de madera en el HUD principal si existe
        if (type === 'wood') {
            const woodHud = document.getElementById('ui-wood');
            if (woodHud) woodHud.innerText = getData().wood;
        }
    }

    function getData() {
        let woodItem = items.find(i => i.type === 'wood');
        let stoneItem = items.find(i => i.type === 'stone');
        return {
            wood: woodItem ? woodItem.count : 0,
            stone: stoneItem ? stoneItem.count : 0,
            slotsUsed: items.filter(i => i.count > 0).length
        };
    }

    return {
        init,
        toggle,
        addItem,
        getData
    };
})();

window.InventoryModule = InventoryModule;
